# Postgres connection string. Matches the defaults in docker-compose.yml.
DATABASE_URL=postgresql://splitbill:splitbill@localhost:5432/splitbill

# Port the Hono API listens on. The Nuxt app uses 3000, so the API defaults to 3001.
PORT=3001

# Browser origins allowed to call the API. Comma-separate more than one.
# Nuxt's default dev server is http://localhost:3000.
CORS_ORIGIN=http://localhost:3000

# OpenAI vision API key. Required only for POST /bills/parse.
# Leave this blank to run the rest of the API; parse responds with 503 until it is set.
# Never commit a real key.
OPENAI_API_KEY=

# Vision model. gpt-4o accepts bill photos and strict JSON schema output.
# Override with another vision-capable model (for example gpt-4o-mini) if you want.
OPENAI_MODEL=gpt-4o

# Override only when calling a proxy or an OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Base URL of apps/api. No trailing slash. Used when the mock layer is off.
NUXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Real API unless this is exactly true or 1. Production must leave it unset
# or false: a missing variable must not store bills in localStorage.
# `pnpm dev` sets true when this is unset, so local development can run
# without apps/api. Set false here (copy to .env) to call the API from the
# dev server instead.
NUXT_PUBLIC_USE_MOCK_API=false

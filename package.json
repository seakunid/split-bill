{
  "name": "split-bill",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --sort --if-present run build",
    "typecheck": "pnpm -r --sort --if-present run typecheck",
    "test": "pnpm -r --sort --if-present run test",
    "dev": "pnpm --filter @split-bill/api dev",
    "db:migrate": "pnpm --filter @split-bill/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @split-bill/api exec prisma migrate deploy"
  }
}

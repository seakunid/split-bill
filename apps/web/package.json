{
  "name": "@split-bill/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "node ./scripts/dev.mjs",
    "build": "pnpm --filter @split-bill/shared build && nuxt build",
    "preview": "nuxt preview --host 0.0.0.0 --port 3000",
    "typecheck": "pnpm --filter @split-bill/shared build && nuxt typecheck",
    "test": "pnpm --filter @split-bill/shared build && vitest run"
  },
  "dependencies": {
    "@fontsource/literata": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@split-bill/shared": "workspace:*",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.12"
  }
}
